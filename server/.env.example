# ============ SERVER ============
PORT=5000
NODE_ENV=development

# ============ DATABASE (PostgreSQL) ============
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=peoplepay_db

# ============ JWT ============
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
JWT_REFRESH_EXPIRE=7d

# ============ REDIS ============
# Option A: Connection URL (Redis Cloud / Upstash)
# REDIS_URL=redis://default:password@host:6379/0
# Option B: Individual params (local Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=peoplepay360:

# ============ OTP ============
OTP_SECRET=your_otp_hmac_secret_here_min_32_chars

# ============ EMAIL (Nodemailer) ============
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=PeoplePay <your_email@gmail.com>

# ============ CORS ============
CLIENT_URL=http://localhost:5173

# ============ SEED (only needed when running node seed.js) ============
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=ChangeMe@123
